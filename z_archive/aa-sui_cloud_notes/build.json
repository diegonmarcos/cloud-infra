{
  "name": "cloud-notes",
  "description": "Cloud Notes Collaborative Workspace (drive-notes.diegonmarcos.com) — deployed via hedgedoc flake",
  "category": "app",
  "domain": "drive-notes.diegonmarcos.com",
  "deploy": {
    "host": "oci-apps",
    "remote_path": "/opt/containers/cloud-notes"
  },
  "proxy": {
    "upstream": "cloud-notes.app:3010",
    "auth": "two_factor",
    "max_upload": "100MB",
    "timeout": "3600s"
  },
  "health": {
    "path": "/"
  },
  "monitoring": {
    "tls_check": true,
    "dns_check": true,
    "endpoint_check": true
  },
  "backup": {
    "enabled": true,
    "volumes": ["cloud_notes_data"]
  }
}
