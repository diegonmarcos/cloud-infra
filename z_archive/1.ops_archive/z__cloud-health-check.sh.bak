#!/bin/bash
#
# Cloud Health Check - Daily Report
# Sends health status via swaks to me@diegonmarcos.com
#

# Don't exit on first error - we want full report
# set -e

# Configuration
TO_EMAIL="me@diegonmarcos.com"
FROM_EMAIL="no-reply@diegonmarcos.com"
SMTP_SERVER="route1.mx.cloudflare.net"
SMTP_PORT="25"

# VM IPs
OCI_MICRO_1="130.110.251.193"  # Mailu
OCI_MICRO_2="129.151.228.66"   # Matomo
GCP_MICRO_1="35.226.147.64"    # NPM/Authelia
OCI_FLEX_1="84.235.234.87"     # Photoprism (wake-on-demand)

# Start report
REPORT="CLOUD HEALTH REPORT - $(date '+%Y-%m-%d %H:%M:%S UTC')\n"
REPORT+="============================================================\n\n"

# Function to check HTTP endpoint
check_http() {
    local name="$1"
    local url="$2"
    local expected="${3:-200}"

    local status
    status=$(curl -s -o /dev/null -w "%{http_code}" -m 10 "$url" 2>/dev/null || echo "000")

    if [[ "$status" == "$expected" ]] || [[ "$status" == "301" ]] || [[ "$status" == "302" ]]; then
        echo "  [OK] $name ($status)"
        return 0
    else
        echo "  [FAIL] $name ($status)"
        return 1
    fi
}

# Function to check TCP port
check_port() {
    local name="$1"
    local host="$2"
    local port="$3"

    if timeout 5 nc -z "$host" "$port" 2>/dev/null; then
        echo "  [OK] $name ($host:$port)"
        return 0
    else
        echo "  [FAIL] $name ($host:$port)"
        return 1
    fi
}

# Function to check ping
check_ping() {
    local name="$1"
    local host="$2"

    if ping -c 1 -W 3 "$host" &>/dev/null; then
        echo "  [OK] $name ($host)"
        return 0
    else
        echo "  [FAIL] $name ($host)"
        return 1
    fi
}

FAILURES=0

# === VM Connectivity (via SSH port) ===
REPORT+="VM CONNECTIVITY\n"
REPORT+="---------------\n"

VM_STATUS=""
VM_STATUS+=$(check_port "OCI Micro 1 (Mail)" "$OCI_MICRO_1" "22") || ((FAILURES++))
VM_STATUS+="\n"
VM_STATUS+=$(check_port "OCI Micro 2 (Analytics)" "$OCI_MICRO_2" "22") || ((FAILURES++))
VM_STATUS+="\n"
VM_STATUS+=$(check_port "GCP Micro 1 (Proxy)" "$GCP_MICRO_1" "22") || ((FAILURES++))
VM_STATUS+="\n"
VM_STATUS+=$(check_port "OCI Flex 1 (Photos)" "$OCI_FLEX_1" "22") || true  # Wake-on-demand, may be off
VM_STATUS+="\n"

REPORT+="$VM_STATUS\n"

# === Web Services ===
REPORT+="WEB SERVICES\n"
REPORT+="------------\n"

WEB_STATUS=""
WEB_STATUS+=$(check_http "Analytics (Matomo)" "https://analytics.diegonmarcos.com") || ((FAILURES++))
WEB_STATUS+="\n"
WEB_STATUS+=$(check_http "Proxy Admin (NPM)" "https://proxy.diegonmarcos.com") || ((FAILURES++))
WEB_STATUS+="\n"
WEB_STATUS+=$(check_http "Auth (Authelia)" "https://auth.diegonmarcos.com") || ((FAILURES++))
WEB_STATUS+="\n"
WEB_STATUS+=$(check_http "Mail Webmail" "https://mail.diegonmarcos.com/webmail" "302") || ((FAILURES++))
WEB_STATUS+="\n"
WEB_STATUS+=$(check_http "Cloud Dashboard" "https://cloud.diegonmarcos.com") || ((FAILURES++))
WEB_STATUS+="\n"

REPORT+="$WEB_STATUS\n"

# === Mail Services ===
REPORT+="MAIL SERVICES\n"
REPORT+="-------------\n"

MAIL_STATUS=""
MAIL_STATUS+=$(check_port "SMTP (465)" "$OCI_MICRO_1" "465") || ((FAILURES++))
MAIL_STATUS+="\n"
MAIL_STATUS+=$(check_port "IMAP (993)" "$OCI_MICRO_1" "993") || ((FAILURES++))
MAIL_STATUS+="\n"
MAIL_STATUS+=$(check_port "SMTP Proxy (8080)" "$OCI_MICRO_1" "8080") || ((FAILURES++))
MAIL_STATUS+="\n"

REPORT+="$MAIL_STATUS\n"

# === Summary ===
REPORT+="SUMMARY\n"
REPORT+="-------\n"
if [[ $FAILURES -eq 0 ]]; then
    REPORT+="  All systems operational\n"
    SUBJECT="[OK] Cloud Health Report - $(date '+%Y-%m-%d')"
else
    REPORT+="  $FAILURES service(s) with issues\n"
    SUBJECT="[ALERT] Cloud Health Report - $FAILURES issues - $(date '+%Y-%m-%d')"
fi

REPORT+="\n--\nGenerated by cloud-health-check.sh\n"

# === Send Email via SMTP Proxy ===
echo -e "$REPORT"

echo ""
echo "Sending report via SMTP Proxy..."

# Build RFC822 email
EMAIL_BODY="From: $FROM_EMAIL
To: $TO_EMAIL
Subject: $SUBJECT
Date: $(date -R)
Content-Type: text/plain; charset=utf-8

$(echo -e "$REPORT")"

# Send via SMTP proxy
RESPONSE=$(curl -s -X POST "http://smtp.diegonmarcos.com:8080/" \
    -H "Content-Type: text/plain" \
    -H "X-API-Key: <redacted-api-key>" \
    --data-binary "$EMAIL_BODY" \
    --max-time 30 2>&1)

if echo "$RESPONSE" | grep -q "delivered"; then
    echo "Email sent successfully!"
    echo "$RESPONSE"
else
    echo "Failed to send email:"
    echo "$RESPONSE"

    # Fallback: try swaks directly (works from cloud VMs)
    echo ""
    echo "Trying swaks fallback..."
    swaks \
        --to "$TO_EMAIL" \
        --from "$FROM_EMAIL" \
        --server "$SMTP_SERVER" \
        --port "$SMTP_PORT" \
        --header "Subject: $SUBJECT" \
        --body "$(echo -e "$REPORT")" \
        --timeout 30 2>&1 || echo "Swaks also failed"
fi

echo "Done!"
