#!/usr/bin/env bash

# ╔══════════════════════════════════════════════════════════════════╗
# ║                                                                  ║
# ║   GENERATED FILE — DO NOT EDIT                                   ║
# ║                                                                  ║
# ║   Source : 1_configs/src/git-hooks/post-merge
# ║   Engine : 1_configs/src/scripts/cloud-ship-repo-workflow-engine.sh
# ║   Rebuild: ./1_configs/build.sh
# ║                                                                  ║
# ║   Manual edits will be overwritten on next build.                ║
# ║                                                                  ║
# ╚══════════════════════════════════════════════════════════════════╝

# ╔══════════════════════════════════════════════════════════════════╗
# ║ post-merge — rebase submodules after pull/merge                  ║
# ║                                                                  ║
# ║ Source: cloud/1_configs/src/git-hooks/post-merge                   ║
# ║ Active via [core] hooksPath = 1_configs/dist/hooks             ║
# ║                                                                  ║
# ║ Fires after `git pull` and `git merge`. Pulls each submodule     ║
# ║ worktree onto its upstream HEAD (rebased) so local submodule     ║
# ║ contents always reflect upstream immediately after a pull.       ║
# ║ Non-blocking: never fails the merge result.                      ║
# ╚══════════════════════════════════════════════════════════════════╝
set -uo pipefail

# ── Safer-alternative reminder ──────────────────────────────────────
if [ -t 2 ]; then
  printf '\033[33m\n┌─ git pull ─ tip ──────────────────────────────────────────────┐\n' >&2
  printf   '│ Prefer `git sync` — safer: auto-stash + rebase + submodules.  │\n' >&2
  printf   '│   git sync remote   (origin wins on conflict, default)        │\n' >&2
  printf   '│   git sync local    (local commits win on conflict)           │\n' >&2
  printf   '│   script: 1_configs/dist/scripts/cloud-git-sync.sh          │\n' >&2
  printf   '└───────────────────────────────────────────────────────────────┘\033[0m\n' >&2
fi

[ -f .gitmodules ] || exit 0

echo "[post-merge] rebasing submodules onto upstream HEAD..."
git submodule update --init --recursive --remote --rebase \
  || echo "[post-merge] submodule rebase reported errors (non-blocking)." >&2

# ── Auto-nuke any dirty submodule ───────────────────────────────────
# Submodules are read-only from this repo. See post-checkout for rationale.
NUKE="$(git rev-parse --show-toplevel 2>/dev/null)/1_configs/dist/scripts/cloud-git-nuke.sh"
if [ -x "$NUKE" ] || [ -f "$NUKE" ]; then
  git config --file .gitmodules --get-regexp 'submodule\..*\.path' 2>/dev/null \
    | awk '{print $2}' \
    | while IFS= read -r _sm; do
        [ -n "$_sm" ] || continue
        [ -d "$_sm/.git" ] || [ -f "$_sm/.git" ] || continue
        # Unset GIT_INDEX_FILE / GIT_DIR / GIT_WORK_TREE — they leak from
        # the parent git invocation and break submodule .git pointer-file lookups.
        if [ -n "$(env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE git -C "$_sm" status --porcelain 2>/dev/null | head -1)" ]; then
          echo "[post-merge] dirty submodule '$_sm' — auto-nuking..." >&2
          (cd "$_sm" && env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE bash "$NUKE" -q 2>/dev/null) \
            || echo "[post-merge] nuke failed for '$_sm' (non-blocking)." >&2
        fi
      done
fi

# ── Mark submodule files read-only at the OS level ──────────────────
# See post-checkout for full rationale. Files RO, dirs writable.
git config --file .gitmodules --get-regexp 'submodule\..*\.path' 2>/dev/null \
  | awk '{print $2}' \
  | while IFS= read -r _sm; do
      [ -n "$_sm" ] || continue
      [ -d "$_sm" ] || continue
      find "$_sm" -type f -not -path "$_sm/.git/*" -not -name '.git' \
        -exec chmod a-w {} + 2>/dev/null || true
    done

exit 0
