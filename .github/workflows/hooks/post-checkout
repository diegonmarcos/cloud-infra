#!/usr/bin/env bash

# ╔══════════════════════════════════════════════════════════════════╗
# ║                                                                  ║
# ║   GENERATED FILE — DO NOT EDIT                                   ║
# ║                                                                  ║
# ║   Source : 0_git/src/hooks/post-checkout
# ║   Engine : 1_cicd/src/scripts/cloud-ship-repo-workflow-engine.sh
# ║   Rebuild: ./9_others/build.sh
# ║                                                                  ║
# ║   Manual edits will be overwritten on next build.                ║
# ║                                                                  ║
# ╚══════════════════════════════════════════════════════════════════╝

# ╔══════════════════════════════════════════════════════════════════╗
# ║ post-checkout — sync submodules after branch switch              ║
# ║                                                                  ║
# ║ Source: cloud/0_git/src/hooks/post-checkout                ║
# ║ Active via [core] hooksPath = 0_git/dist/hooks             ║
# ║                                                                  ║
# ║ Fires after `git checkout <branch>`. Args: old_ref new_ref       ║
# ║ flag (1 = branch switch, 0 = file checkout). Only syncs on       ║
# ║ branch switch. Rebases submodules onto upstream HEAD so the      ║
# ║ worktree reflects fresh content for the newly-checked-out ref.   ║
# ║ Non-blocking.                                                    ║
# ╚══════════════════════════════════════════════════════════════════╝
set -uo pipefail

flag="${3:-0}"
[ "$flag" = "1" ] || exit 0   # only branch/ref switch, not plain file checkout
[ -f .gitmodules ] || exit 0

echo "[post-checkout] rebasing submodules onto upstream HEAD..."
git submodule update --init --recursive --remote --rebase \
  || echo "[post-checkout] submodule rebase reported errors (non-blocking)." >&2

# ── Auto-nuke any dirty submodule ───────────────────────────────────
# Submodules are read-only from this repo. Any local changes (modified,
# deleted, untracked) are accidental and must not persist past a checkout.
# Reactive cleanup: hard-reset to origin via cloud-git-nuke.sh.
NUKE="$(git rev-parse --show-toplevel 2>/dev/null)/1_cicd/dist/scripts/cloud-git-nuke.sh"
if [ -x "$NUKE" ] || [ -f "$NUKE" ]; then
  git config --file .gitmodules --get-regexp 'submodule\..*\.path' 2>/dev/null \
    | awk '{print $2}' \
    | while IFS= read -r _sm; do
        [ -n "$_sm" ] || continue
        [ -d "$_sm/.git" ] || [ -f "$_sm/.git" ] || continue
        # Unset GIT_INDEX_FILE / GIT_DIR / GIT_WORK_TREE — they leak from
        # the parent git invocation and break submodule .git pointer-file lookups.
        if [ -n "$(env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE git -C "$_sm" status --porcelain 2>/dev/null | head -1)" ]; then
          echo "[post-checkout] dirty submodule '$_sm' — auto-nuking..." >&2
          (cd "$_sm" && env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE bash "$NUKE" -q 2>/dev/null) \
            || echo "[post-checkout] nuke failed for '$_sm' (non-blocking)." >&2
        fi
      done
fi

# ── Mark submodule files read-only at the OS level ──────────────────
# Proactive defence: chmod a-w on every file under every submodule mount.
# Files become non-writable (open(O_WRONLY) ⇒ EACCES); directories stay
# writable so `git submodule update --remote` can still swap contents.
# chmod state is NOT stored in git (only the executable bit is tracked),
# so this is purely local to this checkout — the upstream submodule repos
# are untouched. Skip .git pointer/dir to not break git internals.
git config --file .gitmodules --get-regexp 'submodule\..*\.path' 2>/dev/null \
  | awk '{print $2}' \
  | while IFS= read -r _sm; do
      [ -n "$_sm" ] || continue
      [ -d "$_sm" ] || continue
      find "$_sm" -type f -not -path "$_sm/.git/*" -not -name '.git' \
        -exec chmod a-w {} + 2>/dev/null || true
    done
exit 0
