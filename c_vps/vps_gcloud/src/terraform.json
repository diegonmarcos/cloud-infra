{
  "provider": {
    "name": "google",
    "version": "~> 5.0",
    "project_id": "diegonmarcos-infra-prod",
    "region": "us-central1",
    "zone": "us-central1-a"
  },

  "network": {
    "name": "default",
    "description": "Default network for the project",
    "auto_create_subnetworks": true,
    "prevent_destroy": true
  },

  "_firewall_rules_doc": "REVERT of Phase 6 (PR #26) — production outage: PR #26 destroyed allow-https while DNS still pointed at gcp-proxy (Phase 4 Caddy migration to oci-analytics had not landed). Restoring allow-https + https-server tag to keep public 443 ingress on gcp-proxy until Phases 4+5 deploy.",
  "firewall_rules": [
    { "name": "allow-https",           "protocol": "tcp", "ports": ["443"],   "source": "0.0.0.0/0", "tags": ["https-server"],                           "description": "Allow HTTPS traffic (Caddy + caddy-l4 SNI mux for IMAPS/SMTPS)" },
    { "name": "allow-wireguard",       "protocol": "udp", "ports": ["51820"], "source": "0.0.0.0/0", "tags": [],                                        "description": "WireGuard wg0 mesh primary (gcp-proxy = hub)" },
    { "name": "allow-wireguard-fallback", "protocol": "udp", "ports": ["443"], "source": "0.0.0.0/0", "tags": [],                                        "description": "WireGuard wg0 fallback — host firewall.nix REDIRECTs udp/443 → udp/51820 for networks blocking 51820" }
  ],

  "static_ips": [
    { "name": "arch-1-ip", "region": "us-central1" },
    { "name": "gcp-t4-embed-ip", "region": "us-central1" }
  ],

  "instances": [
    {
      "name": "gcp-t4-embed",
      "alias": "gcp-t4-embed",
      "instance_id": "projects/diegonmarcos-infra-prod/zones/us-central1-a/instances/gcp-t4-embed",
      "description": "On-demand N1-Standard-4 + NVIDIA T4 GPU — cgc octocode GPU embedding runner (ollama nomic-embed-text behind Caddy bearer-auth on :443, see startup-gpu-embed.sh). STOPPED between cgc-db-index.yml semantic-phase runs (devops_vm_start/stop around the android job). preemptible=false: project quota is PREEMPTIBLE_CPUS=0 in us-central1 (verified 2026-09-03) so Spot is unavailable — on-demand only.",
      "machine_type": "n1-standard-4",
      "image": "projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts",
      "disk_size_gb": 100,
      "disk_type": "pd-ssd",
      "tags": ["https-server", "gpu-embed"],
      "static_ip_name": "gcp-t4-embed-ip",
      "preemptible": false,
      "automatic_restart": true,
      "on_host_maintenance": "TERMINATE",
      "gpu": { "type": "nvidia-tesla-t4", "count": 1 },
      "scopes": [
        "https://www.googleapis.com/auth/devstorage.read_only",
        "https://www.googleapis.com/auth/logging.write",
        "https://www.googleapis.com/auth/monitoring.write"
      ],
      "ignore_changes": ["boot_disk"]
    },
    {
      "name": "gcp-proxy",
      "alias": "gcp-proxy",
      "instance_id": "projects/diegonmarcos-infra-prod/zones/us-central1-a/instances/gcp-proxy",
      "description": "always-on free tier e2-micro (Fedora) — replacement for arch-1",
      "machine_type": "e2-micro",
      "image": "projects/fedora-cloud/global/images/family/fedora-cloud-42-x86-64",
      "disk_size_gb": 30,
      "disk_type": "pd-standard",
      "tags": ["http-server", "https-server"],
      "static_ip_name": "arch-1-ip",
      "preemptible": false,
      "automatic_restart": true,
      "on_host_maintenance": "MIGRATE",
      "gpu": null,
      "scopes": [
        "https://www.googleapis.com/auth/devstorage.read_only",
        "https://www.googleapis.com/auth/logging.write",
        "https://www.googleapis.com/auth/monitoring.write",
        "https://www.googleapis.com/auth/pubsub",
        "https://www.googleapis.com/auth/service.management.readonly",
        "https://www.googleapis.com/auth/servicecontrol",
        "https://www.googleapis.com/auth/trace.append"
      ],
      "ignore_changes": ["boot_disk"]
    }
  ],

  "service_account": {
    "email": "514615763870-compute@developer.gserviceaccount.com"
  },

  "budget": {
    "billing_account": "016370-B652E5-7E0A8A",
    "display_name": "GCP Spot GPU 30 EUR",
    "currency": "EUR",
    "amount": 30,
    "thresholds": [0.5, 0.9, 1.0]
  }
}
