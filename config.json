  "native": {
    "wireguard": {
      "vm": "all",
      "description": "WireGuard VPN mesh — managed via home-manager (not Docker)",
      "subnet": "10.0.0.0/24",
      "port": 51820,
      "port_fallback": 443,
      "port_fallback_proto": "udp",
      "port_fallback_description": "Hub-side NAT redirect (deployed Phase 4 via firewall.nix): udp/443 → udp/51820 on gcp-proxy. Clients on networks blocking udp/51820 (airports, hotels) switch to this port.",
      "wg_hub": "gcp-E2-f_0",
      "peers": [
        "oci-E2-f_0",
        "oci-E2-f_1",
        "oci-A1-f_0"
      ],
      "clients": {
        "surface": {
          "wg_ip": "10.0.0.5",
          "role": "client"
        },
        "termux": {
          "wg_ip": "10.0.0.9",
          "role": "client"
        },
        "gha-runner": {
          "wg_ip": "10.0.0.200",
          "role": "client"
        }
      }
    },
    "_wireguard_public_moved_doc": "wg-public mesh topology + client list MOVED OUT of config.json. New source of truth: a_solutions/infra-net_wireguard-public/build.json (top-level wireguard_public block). Adding/rotating/sharing a wg-public client is a single-file edit there — keeps the global root config focused on cross-cutting topology (vms, wg0, dns, docker, monitoring) and not on individual access-control rows. Consolidator engine: 2_configs/src/engines/cloud-data-config-consolidated.ts reads from the new build.json first, falls back to config.json::wireguard_public only if the build.json is missing (transitional). Once tested + verified, the fallback can be removed. Server-side peer pubkeys still come from vault/A0_keys/providers/wireguard/<name>-public/publickey.",
    "dns": {
      "primary": "10.0.0.1",
      "fallback": "1.1.1.1",
