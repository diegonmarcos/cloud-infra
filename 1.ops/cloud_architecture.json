      "_description": "Kinoite initramfs requires manual patching for USB keyfile LUKS unlock",
      "structure": {
        "earlyOffset": "0-29829 blocks (512B each) = 15,272,448 bytes",
        "mainArchive": "gzip compressed cpio after early_cpio",
        "backupLocation": "/boot/kinoite/initramfs.img.bak"
