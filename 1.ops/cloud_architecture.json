      "addedComponents": [
        {"path": "/usr/sbin/cryptsetup", "source": "Kinoite deployment"},
        {"path": "/usr/lib64/libcryptsetup.so.12*", "source": "Kinoite deployment"},
        {"path": "/etc/crypttab", "content": "pool UUID=<luks-uuid> /usb-key/.luks/surface.key luks,timeout=5"},
