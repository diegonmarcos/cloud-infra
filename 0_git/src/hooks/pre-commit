#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════╗
# ║ pre-commit — block secrets from ever reaching a commit           ║
# ║                                                                  ║
# ║ Source: cloud/0_git/src/hooks/pre-commit                     ║
# ║ Deploy: build.sh workflow → 0_git/dist/hooks/                ║
# ║ Active: via .gitconfig [core] hooksPath = 0_git/dist/hooks   ║
# ║                                                                  ║
# ║ KEEP IN SYNC with .gitignore patterns.                           ║
# ║ Catches secrets even after git add -f (gitignore bypass).        ║
# ╚══════════════════════════════════════════════════════════════════╝
set -uo pipefail  # no -e: grep exit codes are handled by || true

# Helper: invoke git in a submodule with parent-git env unset.
# Git sets GIT_INDEX_FILE / GIT_DIR / GIT_WORK_TREE when calling hooks;
# if those leak into `git -C <submodule>` calls, the submodule lookup
# fails because it tries to open <submodule>/.git/index, but a submodule's
# .git is a FILE-pointer, not a directory. Result: silent failure → the
# whole submodule-dirty-check goes blind. Always invoke nested submodule
# git ops via this helper.
sm_git() {
  env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE git "$@"
}

STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0

# ── BLOCK STAGED PATHS INSIDE SUBMODULES ──────────────────────────────
# Submodules are READ-ONLY from this repo's perspective. Anything staged
# under a submodule mount is a leak that would silently change the SHA
# pointer (or not work at all) — caught proactively here.
# Files inside submodules belong to a different repo; edits there must
# happen in that repo (e.g. ~/git/cloud-data for cloud/I_cloud-data).
SUBMODULE_PATHS=$(git config --file .gitmodules --get-regexp 'submodule\..*\.path' 2>/dev/null | awk '{print $2}')
if [ -n "$SUBMODULE_PATHS" ]; then
  SM_LEAK=""
  while IFS= read -r _sm; do
    [ -n "$_sm" ] || continue
    _hits=$(echo "$STAGED" | grep -E "^${_sm}/" || true)
    [ -n "$_hits" ] && SM_LEAK="${SM_LEAK}${_hits}"$'\n'
  done <<< "$SUBMODULE_PATHS"
  if [ -n "$SM_LEAK" ]; then
    echo "══════════════════════════════════════════════════" >&2
    echo "BLOCKED: staged files inside a SUBMODULE mount" >&2
    echo "══════════════════════════════════════════════════" >&2
    echo "$SM_LEAK" | sort -u | sed '/^$/d' | sed 's/^/  - /' >&2
    echo >&2
    echo "Submodules are read-only here. Edit the source repo instead:" >&2
    echo "  cloud/ → the fleet index (~/git/cloud); fleet repos live as standalone clones in ~/git" >&2
    echo "Commit + push there, then 'git submodule update --remote' here." >&2
    exit 1
  fi
fi

BLOCKED=""

# ── UNIVERSAL GITIGNORE-BYPASS DETECTOR ──────────────────
# Catches ANY file staged despite a matching .gitignore rule (i.e.
# force-staged via `git add -f`). Highest-value defence — gitignore
# exists precisely to keep secrets out; `-f` is the common leak vector.
# --no-index forces evaluation of gitignore rules as if unindexed
# (git check-ignore otherwise silently skips files in the index).
# Only fire for files NOT in HEAD (tracked-path edits are fine).
FORCED=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -e "$f" ] || continue
  if git check-ignore --no-index -q -- "$f" 2>/dev/null \
     && ! git cat-file -e "HEAD:$f" 2>/dev/null; then
    FORCED="${FORCED}${f}"$'\n'
  fi
done <<< "$STAGED"

if [ -n "$FORCED" ]; then
  echo "══════════════════════════════════════════════════" >&2
  echo "BLOCKED: gitignored files force-staged (git add -f)" >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "$FORCED" | sort -u | sed '/^$/d' | while IFS= read -r f; do
    rule=$(git check-ignore --no-index -v -- "$f" 2>/dev/null | head -1)
    echo "  - $f" >&2
    [ -n "$rule" ] && echo "      matches: $rule" >&2
  done
  echo "NEVER use 'git add -f' / '--force' to override gitignore." >&2
  exit 1
fi

# ── SUBMODULES ARE READ-ONLY FROM PARENT REPO — SILENT IGNORE ──
# Policy: any attempt to add/commit anything related to submodules is
# silently dropped. The user never sees an error or banner; the commit
# proceeds with submodule-related changes filtered out and dirty submodule
# worktrees auto-nuked.
#
# Two enforcements (data-driven from .gitmodules — portable across any repo):
#
#   (a) Staged paths inside submodule directory or the gitlink itself
#       are silently auto-unstaged (`git reset HEAD <path>`).
#
#   (b) Dirty submodule worktrees are silently auto-nuked
#       (cloud-git-nuke.sh = fetch + reset --hard origin + clean -fdx).
#
# All output suppressed via stderr+stdout redirect to /dev/null.
if [ -f .gitmodules ]; then
  SUBMODULE_PATHS=$(git config --file .gitmodules --get-regexp 'submodule\..*\.path' 2>/dev/null | awk '{print $2}')

  # (a) Silently auto-unstage submodule paths
  if [ -n "$SUBMODULE_PATHS" ]; then
    while IFS= read -r _sm_path; do
      [ -n "$_sm_path" ] || continue
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        case "$f" in
          "$_sm_path"|"$_sm_path"/*)
            git reset -q HEAD -- "$f" >/dev/null 2>&1
            ;;
        esac
      done <<< "$STAGED"
    done <<< "$SUBMODULE_PATHS"
    unset _sm_path
    # Refresh STAGED list — paths may have been unstaged
    STAGED=$(git diff --cached --name-only)
    [ -z "$STAGED" ] && exit 0
  fi

  # (b) Silently auto-nuke any dirty submodule worktree
  if [ -n "$SUBMODULE_PATHS" ]; then
    NUKE="$(git rev-parse --show-toplevel 2>/dev/null)/1_cicd/dist/scripts/cloud-git-nuke.sh"
    while IFS= read -r _sm_path; do
      [ -n "$_sm_path" ] || continue
      [ -d "$_sm_path/.git" ] || [ -f "$_sm_path/.git" ] || continue
      # sm_git unsets GIT_INDEX_FILE etc — see helper at top of hook.
      _dirty=$(sm_git -C "$_sm_path" status --porcelain 2>/dev/null | head -1)
      if [ -n "$_dirty" ] && [ -f "$NUKE" ]; then
        (cd "$_sm_path" && env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE \
            bash "$NUKE" -q >/dev/null 2>&1) || true
      fi
    done <<< "$SUBMODULE_PATHS"
    unset _sm_path _dirty NUKE
  fi
fi

add_blocked() {
  local matches
  matches=$(echo "$STAGED" | eval "$1" || true)
  [ -n "$matches" ] && BLOCKED="${BLOCKED}${matches}"$'\n'
}

# ── Secrets & Credentials ────────────────────────────────

# P1: .secrets and .secrets.d/ (dot-prefixed)
add_blocked "grep -E '(^|/)\.secrets(/|$)'"

# P2: *.secrets (any file ending in .secrets)
add_blocked "grep -E '\.secrets$'"

# P3: decrypted sops output in dist/
add_blocked "grep -E 'dist/\.secrets'"

# ── Environment files ────────────────────────────────────

# P4: .env files (not .example or .template)
add_blocked "grep -E '(^|/)\.env(\.|$)' | grep -v '\.example' | grep -v '\.template'"

# ── Private keys & certificates ──────────────────────────

# P5: private keys (id_rsa, id_ed25519, id_ecdsa) — exclude _PUB
add_blocked "grep -iE '(id_rsa|id_ed25519|id_ecdsa)$' | grep -iv '_PUB$'"

# P6: key/cert files (.pem, .key, .p12, .pfx, .jks, .keystore)
add_blocked "grep -iE '\.(pem|key|p12|pfx|jks|keystore)$'"

# ── Auth tokens & credentials ────────────────────────────

# P7: token files
add_blocked "grep -iE '\.token$'"

# P8: credentials JSON files
add_blocked "grep -iE 'credentials.*\.json$'"

# P9: *_token.json / *_tokens.json
add_blocked "grep -iE '_tokens?\.json$'"

# ── Cloud provider configs ───────────────────────────────

# P10: .oci/ and .gcloud/ directories
add_blocked "grep -E '(^|/)\.(oci|gcloud)/'"

# ── GPG & age ────────────────────────────────────────────

# P11: GPG armored files
add_blocked "grep -iE '\.asc$'"

# P12: age key files (not .age.pub)
add_blocked "grep -iE '\.age$' | grep -v '\.age\.pub$'"

# P13: age.key and keys.txt
add_blocked "grep -iE '(age\.key|keys\.txt)$'"

# ── Terraform secrets ────────────────────────────────────

# P14: .tfvars files (not .tfvars.example)
add_blocked "grep -iE '\.tfvars$' | grep -v '\.example$'"

# P15: terraform.tfvars specifically
add_blocked "grep -E '(^|/)terraform\.tfvars$'"

# P17: dist layout v2 gitignored sub-dirs
add_blocked "grep -E 'dist/(secrets|sensitive|\.build)/'"

# ── CONTENT-SCAN: secret-named file MUST be sops-encrypted ─────────
# Filename alone is insufficient — the 2026-04-17 stalwart leak was a
# `secrets.yaml.new` with plaintext content committed to a public repo.
# Right defense: if filename contains secret-like tokens, the content
# MUST contain `ENC[AES` or `sops:` markers. Otherwise → BLOCK.
# This ALLOWS secrets.yaml/.new/.draft/etc. — as long as sops-encrypted.
# Exact renames (R100) carry content that was already vetted when it was
# first committed. They must be identified BEFORE the loop: `git diff
# --cached -- <newpath>` cannot pair a rename, because the old path is
# excluded by its own pathspec, so it reports the file as brand new with
# every line added — which is exactly how the 3_secrets -> 2_secrets move
# re-flagged files git itself classified as R100.
RENAMED_EXACT=$(git diff --cached -M --name-status --diff-filter=R 2>/dev/null | awk '$1=="R100"{print $3}')

LEAKY=""
while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$f" ] || continue
    echo "$f" | grep -iqE '(secret|credential|password|token|jwks|dkim|\.pem$|\.key$)' || continue

    # An empty file cannot leak anything.
    [ -s "$f" ] || continue

    # Pure rename of already-committed content.
    printf '%s\n' "$RENAMED_EXACT" | grep -qxF "$f" && continue

    # Scan what this commit ADDS, not the file's whole history. Scanning the
    # whole file made two categories permanently unommittable:
    #   - a pure rename re-presents content that was already vetted when it
    #     was first committed (the 3_secrets -> 2_secrets move re-flagged a
    #     0-byte yaml and an audit .csv holding no values);
    #   - a doc carrying an ILLUSTRATIVE `password: <plaintext>` line blocks
    #     every future edit to that doc, however unrelated.
    # Adding a plaintext secret is still caught: those lines are additions.
    # A brand-new unencrypted secrets file is caught too — every line is one.
    ADDED=$(git diff --cached -U0 -- "$f" 2>/dev/null | grep '^+' | grep -v '^+++' || true)
    [ -n "$ADDED" ] || continue

    # sops-encrypted? (ENC[AES...] somewhere OR a sops footer with ENC[)
    grep -q 'ENC\[AES' "$f" 2>/dev/null && continue
    grep -q '^sops:' "$f" 2>/dev/null && grep -q 'ENC\[' "$f" 2>/dev/null && continue
    # Allow-listed filename patterns (references/templates, not values)
    case "$f" in
        *.example|*.template|*.tpl|*.pub|*_PUB) continue ;;
        */.secrets-hash*|*/.secrets-env-var-names*) continue ;;
        *secrets-env-var-names*.json|*cloud-data-secrets-env-var-names.json) continue ;;
        *secrets-subst.nix) continue ;;
        # Git metadata files are never secret containers, even when their
        # path includes a "secret*" segment (e.g. 2_secrets/.gitignore).
        */.gitignore|.gitignore|*/.gitkeep|.gitkeep|*/.gitattributes|.gitattributes|*/.gitmodules|.gitmodules) continue ;;
        # Dagu DAG yamls under any */dags/ dir (src/dags/, assets/dags/, …)
        # are workflow definitions (schedule + steps), even when the DAG name
        # involves "secrets" (e.g. sync_secrets.yaml). They reference env vars
        # by name (${VAR}), never inline secret values. Gated on DAG structure
        # markers so a real secret file dropped in a dags/ dir still blocks.
        */dags/*.yaml|*/dags/*.yml)
            if grep -qE '^(schedule|steps|type|env):' "$f" 2>/dev/null; then
                continue
            fi
            ;;
        # GitHub Actions workflow YAMLs (engine paths): named-about-secrets
        # files here (e.g. lint-secrets-coverage.yml) define CI lint/audit
        # jobs — never secret containers. Required GHA shape: on: + jobs:.
        .github/workflows/*.yml|1_cicd/src/cicd/*.yml|1_cicd/dist/*.yml)
            if grep -qE '^on:' "$f" 2>/dev/null && grep -qE '^jobs:' "$f" 2>/dev/null; then
                continue
            fi
            ;;
    esac
    # Code files: only flag if contain obvious inline values
    case "$f" in
        *.sh|*.py|*.nix|*.ts|*.js|*.go|*.rs|*.md|*.json)
            if printf '%s\n' "$ADDED" | grep -qiE '^\+?[[:space:]]*(password|admin_password|private_key|api_key|secret)[[:space:]]*[:=][[:space:]]*[^{$_<-]' 2>/dev/null; then
                LEAKY="${LEAKY}${f} (code file with inline secret pattern)"$'\n'
            fi
            continue
        ;;
    esac
    # YAML/TOML/etc. with secret-ish name and no sops markers → LEAK
    LEAKY="${LEAKY}${f}"$'\n'
done <<< "$STAGED"

if [ -n "$LEAKY" ]; then
  echo "══════════════════════════════════════════════════" >&2
  echo "BLOCKED: secret-named file staged WITHOUT sops encryption" >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "$LEAKY" | sort -u | sed '/^$/d' | while IFS= read -r f; do
    echo "  - $f" >&2
  done
  echo "" >&2
  echo "The file matches (secret|credential|password|token|jwks|dkim|*.pem|*.key)." >&2
  echo "It MUST be sops-encrypted (ENC[AES...]) before commit." >&2
  echo "Fix: sops -e -i <file>   OR   git reset HEAD <file>" >&2
  echo "══════════════════════════════════════════════════" >&2
  exit 1
fi

# ── Deduplicate and check ────────────────────────────────
BLOCKED=$(echo "$BLOCKED" | sort -u | sed '/^$/d')

if [ -n "$BLOCKED" ]; then
  echo "══════════════════════════════════════════════════" >&2
  echo "BLOCKED: secrets or private keys staged for commit" >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "$BLOCKED" | while IFS= read -r f; do
    echo "  - $f" >&2
  done
  echo "" >&2
  echo "To unstage: git reset HEAD <file>" >&2
  echo "NO BYPASS EXISTS. Remove the secret files first." >&2
  echo "══════════════════════════════════════════════════" >&2
  exit 1
fi

# ══════════════════════════════════════════════════════════
# Regenerate 1_cicd/dist/ if any engine input changed
# Triggers on staged changes to: ENGINE SOURCES (1_cicd/src/), the derive
# inputs, per-service build.json, per-VM home-manager build.json, or root
# config.json.
#
# 1_cicd/src/ WAS MISSING FROM THIS LIST AND IT COST A FULL DAY (2026-08-12).
# CI executes the GENERATED copies, so an engine fix committed to
# 1_cicd/src/scripts/ alone is invisible to every workflow until somebody
# notices by hand. Two fixes shipped "done" that day and simply never ran:
# the terraform inject-header path fix, and the SSH-timeout + fail-closed-gate
# fix (0dfe680c2) — the latter was diagnosed as still-broken on a live run
# before anyone realised dist/ had never been rebuilt. The hook is the only
# thing that keeps src and dist honest, and it was skipping the one directory
# that holds the engines.
# Auto-stages any resulting diffs so dist/ stays in sync with src/.
# Skip when already inside a regen commit (guard against hook re-entry).
# ══════════════════════════════════════════════════════════
if [ -z "${SKIP_CONFIGS_REGEN:-}" ] \
   && echo "$STAGED" | grep -qE '^(1_cicd/src/|1_cloud-configs/src/derive/|a_solutions/[^/]+/build\.json$|b_infra/nixhm-sudo-[^/]+/build\.json$|config\.json$)'; then
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  BUILD_SH="$REPO_ROOT/9_others/build.sh"
  if [ -x "$BUILD_SH" ]; then
    echo "[pre-commit] engine input staged — regenerating 1_cicd/dist/"
    if ! SKIP_CONFIGS_REGEN=1 "$BUILD_SH" all >/tmp/configs-regen.log 2>&1; then
      echo "[pre-commit] 9_others/build.sh failed — aborting commit. See /tmp/configs-regen.log" >&2
      tail -20 /tmp/configs-regen.log >&2
      exit 1
    fi
    # Auto-stage EVERY tier build.sh regenerates, not just 1_cicd/dist/.
    #
    # `build.sh all` also rewrites .github/workflows/ (and .github/actions/),
    # and GitHub Actions reads those PHYSICAL files — not 1_cicd/dist/. Staging
    # only dist/ meant a commit could carry a freshly regenerated dist while
    # leaving the workflow YAML that CI actually executes stale, so the two
    # halves of one change shipped in different commits (or never).
    #
    # Each path is staged only when its content actually changed, so this stays
    # a no-op for commits that touch none of them.
    for _regen_path in 1_cicd/dist/ .github/workflows/ .github/actions/; do
      if [ -e "$REPO_ROOT/$_regen_path" ] && ! git diff --quiet -- "$_regen_path"; then
        git add "$_regen_path"
        echo "[pre-commit] $_regen_path updated + staged."
      fi
    done

    # THE DERIVER IS NOT PART OF 9_others/build.sh — run it explicitly.
    #
    # 9_others/build.sh only references 1_cloud-configs in comments; it never
    # invokes it. So editing 1_cloud-configs/src/derive/ triggered this block,
    # regenerated every OTHER tier, printed success, and left the one artifact
    # the edit was about — _cloud-data-consolidated.json — untouched.
    #
    # That is the exact bug class behind the 2026-08-12 fleet outage: the
    # carry-forward fix for the WireGuard client keys was correct in the deriver
    # source while the compiled JSON still carried wg_public_key: null, which is
    # what actually unmeshed the CI runner. A deriver change whose output never
    # ships is indistinguishable from no change at all.
    #
    # Only runs when a derive input is staged, so ordinary commits are unaffected.
    # The deriver reads the vault at ~/git/cloud-vault; on a machine without it the
    # keys carry forward from the previous output rather than being nulled.
    if echo "$STAGED" | grep -qE '^1_cloud-configs/src/'; then
      CONFIGS_SH="$REPO_ROOT/1_cloud-configs/build.sh"
      if [ -x "$CONFIGS_SH" ]; then
        echo "[pre-commit] derive input staged — running 1_cloud-configs/build.sh consolidate"
        if ! "$CONFIGS_SH" consolidate >/tmp/derive-regen.log 2>&1; then
          echo "[pre-commit] 1_cloud-configs/build.sh failed — aborting commit. See /tmp/derive-regen.log" >&2
          tail -20 /tmp/derive-regen.log >&2
          exit 1
        fi
        # The consolidated JSON is propagated into a_solutions/*/src/ copies, so
        # stage those too or the service images ship stale fleet data.
        for _derived in 1_cloud-configs/dist/ a_solutions/; do
          if ! git diff --quiet -- "$_derived"; then
            git add "$_derived"
            echo "[pre-commit] $_derived updated + staged (derive)."
          fi
        done
      fi
    fi
  fi
fi
