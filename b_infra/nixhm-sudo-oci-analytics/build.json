{
  "name": "nixhm-sudo-oci-analytics",
  "description": "Home Manager system image for oci-analytics (Matomo, Umami, Dozzle)",
  "vm": {
    "id": "oci-E2-f_1",
    "alias": "oci-analytics",
    "provider": "oci",
    "arch": "x86_64-linux",
    "resources": {
      "cpus": 1,
      "ram_mb": 1024,
      "disk_gb": 47
    },
    "network": {
      "public_ip": "129.151.228.66",
      "wg_ip": "10.0.0.4",
      "wg_port": 51820,
      "wg_role": "spoke",
      "rescue_port": 2200
    }
  },
  "hm": {
    "user": "ubuntu",
    "config": "ubuntu@oci-analytics",
    "delivery": "docker",
    "image": "ghcr.io/diegonmarcos/nixhm-sudo-oci-analytics",
    "platform": "linux/amd64",
    "remote_build": false
  },
  "firewall": {
    "public_ports": [
      {
        "port": 443,
        "proto": "tcp",
        "desc": "HTTPS (wg-public hub — public ingress for external clients via wg-public mesh)",
        "source": "0.0.0.0/0",
        "owned_by": "caddy"
      },
      {
        "port": 25,
        "proto": "tcp",
        "desc": "SMTP MX (wg-public hub — inbound mail relay)",
        "source": "0.0.0.0/0",
        "owned_by": "caddy"
      },
      {
        "port": 465,
        "proto": "tcp",
        "desc": "SMTPS (Submission, implicit TLS) — caddy-l4 → Stalwart on oci-mail :2465",
        "source": "0.0.0.0/0",
        "owned_by": "caddy"
      },
      {
        "port": 993,
        "proto": "tcp",
        "desc": "IMAPS — caddy-l4 → Stalwart on oci-mail :2993",
        "source": "0.0.0.0/0",
        "owned_by": "caddy"
      },
      {
        "port": 4190,
        "proto": "tcp",
        "desc": "ManageSieve — caddy-l4 → Stalwart on oci-mail :6190",
        "source": "0.0.0.0/0",
        "owned_by": "caddy"
      },
      {
        "port": 51821,
        "proto": "udp",
        "desc": "WireGuard wg-public hub — handshake ingress (open enrollment mesh)",
        "source": "0.0.0.0/0",
        "owned_by": "wireguard-public",
        "_doc": "Should be auto-derived by engine from wireguard_public.hub == this VM's alias AND wireguard_public.port. Until that engine refactor, declared explicitly here so the hub actually receives WG handshakes."
      }
    ]
  },
  "dashboard": {
    "dns": "oci-analytics.app",
    "port": 7680
  },
  "deploy": {
    "host": "oci-analytics",
    "remote_path": "~/.config/home-manager"
  },
  "build": {
    "headers_enforced": true
  }
}
