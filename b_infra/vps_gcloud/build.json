{
  "name": "vps-gcloud",
  "description": "GCP infrastructure — VMs, firewall, budget (Terraform)",
  "category": "cloud",
  "build": {
    "copy_only": true
  },
  "deploy": {
    "host": "local",
    "remote_path": "",
    "terraform": true
  },
  "terraform": {
    "tfvars_template": "terraform.tfvars.template",
    "env": {
      "GOOGLE_APPLICATION_CREDENTIALS": "~/.config/gcloud/application_default_credentials.json"
    },
    "env_content": {
      "TF_VAR_ssh_public_key": "~/git/vault/A0_keys/keys/ssh/google_compute_engine.pub"
    }
  }
}
