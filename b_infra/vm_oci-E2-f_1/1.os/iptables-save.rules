# Micro2 oci-f-micro_2 iptables rules
# Pulled: 2026-02-07
# INPUT policy: ACCEPT (no custom firewall, relies on OCI security lists)
# Uses DOCKER-ISOLATION-STAGE (older Docker version)
# Docker networks:
# br-bd6d2b8296ff = windmill-net
# br-2b40a7a75bb5 = matomo-hybrid_default
# br-b1e119466ff9 = sauron
# br-4cf9f4dfac67 = n8n_default
# br-0239b9d897e3 = orchestrator

# Port mappings:
# 8080 → matomo-hybrid (172.21.0.2)
# 127.0.0.1:8000 → windmill (172.25.0.3)
