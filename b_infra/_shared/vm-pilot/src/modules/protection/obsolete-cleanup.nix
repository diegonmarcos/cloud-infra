# protection/obsolete-cleanup.nix — declarative removal of stranded
# systemd units left behind by service migrations (e.g. when a Python
# systemd service became a Docker container, the legacy unit at
# /etc/systemd/system/<name>.service is no longer in any nix module
# but stays on disk and keeps restart-looping forever).
#
# Data source (per-VM):
#   b_infra/nixhm-sudo-<vm>/build.json . protection.obsolete_systemd_units[]
#     [{ unit: "<name>.service", _why: "<rationale>" }, ...]
#   emitted by 9_others into _cloud-data-consolidated.json
#   _home_manager.vms.<vm>.protection — the same channel tier1-apps,
#   load-shedder and health-agent read, and the only one that exists inside
#   the shipped flake (dist/pilot). The old top-level build.json path below
#   is kept as a fallback, but it resolves OUTSIDE the flake source in the
#   dist build, so on its own it was a silent no-op — and the smtp-proxy
#   entry it held was dropped from build.json on 2026-05-08 (edc03c3b),
#   leaving the dead unit restart-looping to 610k restarts by 2026-10-13.
#
# Activation (idempotent — safe to re-run):
#   1. systemctl stop <unit>      (no-op if already stopped)
#   2. systemctl disable <unit>   (no-op if already disabled)
#   3. systemctl mask <unit>      (prevent any future re-enable, including
#                                  by package-installer postinst scripts)
#   4. rm -f /etc/systemd/system/<unit>  (purge the file itself)
#   5. rm -f /etc/systemd/system/multi-user.target.wants/<unit>
#                                 (remove the WantedBy alias if any)
#   6. systemctl daemon-reload    (let systemd forget about it)
#
# FIRE rule 4: list lives in JSON, not in this module. To clean up a
# different unit on a different VM, add it to that VM's build.json —
# do NOT edit this file.
#
{ vmName, ... }:
{ config, pkgs, lib, ... }:
let
  buildJsonPath = ../../../../../nixhm-sudo-${vmName}/build.json;
  buildJson =
    if builtins.pathExists buildJsonPath
    then builtins.fromJSON (builtins.readFile buildJsonPath)
    else {};
  consolidated = builtins.fromJSON (builtins.readFile ../_cloud-data-consolidated.json);
  protVm = (consolidated._home_manager.vms.${vmName} or {}).protection or {};
  obsolete = (protVm.obsolete_systemd_units or [])
          ++ (buildJson.obsolete_systemd_units or []);
  unitNames = map (entry: entry.unit) obsolete;
in
lib.mkIf (obsolete != []) {
  home.activation.obsoleteSystemdUnitsCleanup =
    lib.hm.dag.entryAfter [ "writeBoundary" ] ''
      # Find sudo (NixOS / standard layouts).
      SUDO=""
      for p in /usr/bin/sudo /run/wrappers/bin/sudo /usr/local/bin/sudo /run/current-system/sw/bin/sudo; do
          [ -x "$p" ] && { SUDO="$p"; break; }
      done
      [ -n "$SUDO" ] || { echo "[obsolete-cleanup] sudo not found — skipping"; exit 0; }

      _changed=0
      for unit in ${lib.concatStringsSep " " (map lib.escapeShellArg unitNames)}; do
          unit_path="/etc/systemd/system/$unit"
          want_path="/etc/systemd/system/multi-user.target.wants/$unit"
          if [ -e "$unit_path" ] || $SUDO systemctl is-enabled --quiet "$unit" 2>/dev/null; then
              echo "[obsolete-cleanup] purging $unit"
              $SUDO systemctl stop "$unit"    2>/dev/null || true
              $SUDO systemctl disable "$unit" 2>/dev/null || true
              $SUDO systemctl mask "$unit"    2>/dev/null || true
              $SUDO rm -f "$unit_path" "$want_path"
              $SUDO rmdir "$unit_path.d" 2>/dev/null || true
              _changed=1
          fi
      done
      if [ "$_changed" = "1" ]; then
          $SUDO systemctl daemon-reload
          $SUDO systemctl reset-failed 2>/dev/null || true
          echo "[obsolete-cleanup] daemon-reload + reset-failed done"
      fi
    '';
}
