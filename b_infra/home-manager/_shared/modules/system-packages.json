{
  "_doc": "Single source of truth: every package has a group, every group has a slice. No orphans.",
  "slices": {
    "kernel": {
      "description": "Bare minimum for Linux to function — never touch",
      "service_patterns": [
        "systemd-", "dbus", "dbus-broker", "init.scope",
        "mount", "swap", "fsck", "lvm2", "dm-event", "blk-availability",
        "getty@", "serial-getty@", "user@", "user-runtime-dir@",
        "NetworkManager", "dhclient", "chrony", "ntp"
      ]
    },
    "os-essentials": {
      "description": "Protection + connectivity — must stay responsive under load",
      "service_patterns": []
    },
    "workload": {
      "description": "Docker, containers, application services — capped",
      "service_patterns": []
    }
  },
  "groups": {
    "connectivity": {
      "slice": "os-essentials",
      "scheduling": { "policy": "fifo", "priority": 1 },
      "nice": -10,
      "oom_score": -900,
      "packages": ["wireguard-tools"],
      "services": ["sshd", "ssh", "wg-quick@", "rescue-ssh"]
    },
    "protection": {
      "slice": "os-essentials",
      "scheduling": { "policy": "rr", "priority": 1 },
      "nice": -5,
      "oom_score": -800,
      "packages": [],
      "services": ["earlyoom", "watchdog-petter", "zram-setup"]
    },
    "monitoring": {
      "slice": "os-essentials",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["htop", "btop", "ttyd", "ncdu", "lsof", "iftop", "iotop", "sysstat"],
      "services": ["dashboard-ttyd"]
    },
    "container-runtime": {
      "slice": "workload",
      "scheduling": null,
      "nice": 5,
      "oom_score": 500,
      "packages": ["docker", "docker-compose", "docker-buildx", "youki", "podman"],
      "services": ["docker", "container-init"]
    },
    "secrets": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["sops", "age"],
      "services": []
    },
    "json-yaml": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["jq", "yq-go"],
      "services": []
    },
    "file-transfer": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["rsync", "rclone"],
      "services": []
    },
    "network-tools": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["curl", "wget", "netcat", "iputils", "openssl", "bind", "socat"],
      "services": []
    },
    "vcs": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["git", "gh", "cacert"],
      "services": []
    },
    "text-search": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["ripgrep", "fd", "bat"],
      "services": []
    },
    "compression": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["gzip", "unzip", "zip"],
      "services": []
    },
    "runtimes": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["nodejs_22"],
      "services": []
    },
    "db-clients": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["sqlite", "postgresql_16", "mariadb"],
      "services": []
    },
    "backup": {
      "slice": "workload",
      "scheduling": null,
      "nice": 10,
      "oom_score": 200,
      "packages": ["bup"],
      "services": []
    },
    "security-scanning": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["yara"],
      "services": []
    },
    "system-utils": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": ["tmux", "tree", "bc", "inotify-tools"],
      "services": []
    },
    "code-analysis": {
      "slice": "workload",
      "scheduling": null,
      "nice": 0,
      "oom_score": 0,
      "packages": [],
      "custom_packages": ["octocode.nix"],
      "services": []
    }
  },
  "scopes": {
    "cloud": {
      "description": "All cloud VMs — shared tools",
      "groups": [
        "connectivity", "protection", "monitoring", "container-runtime",
        "secrets", "json-yaml", "file-transfer", "network-tools",
        "vcs", "text-search", "compression", "runtimes",
        "db-clients", "backup", "security-scanning", "system-utils",
        "code-analysis"
      ]
    }
  }
}
