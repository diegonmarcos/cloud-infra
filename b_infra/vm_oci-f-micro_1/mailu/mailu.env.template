# Mailu main configuration file - LIGHTWEIGHT VERSION
# VM: oci-f-micro_1 (130.110.251.193)
# Path on server: /opt/mailu/mailu.env

# Domain and hostnames
DOMAIN=diegonmarcos.com
HOSTNAMES=imap.diegonmarcos.com,smtp.diegonmarcos.com
POSTMASTER=admin

# Secret key for session management
SECRET_KEY=<GENERATE_NEW_SECRET>

# Subnet used by Mailu
SUBNET=192.168.203.0/24

# Main mail domain
DOMAIN=diegonmarcos.com

# Webmail
WEBMAIL=roundcube
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail

# Ports
BIND_ADDRESS4=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
SMTP_PORT=25
IMAP_PORT=993
SUBMISSION_PORT=587

# TLS
TLS_FLAVOR=letsencrypt

# Authentication
AUTH_RATELIMIT_IP=60/hour
AUTH_RATELIMIT_USER=100/day

# Components - LIGHTWEIGHT
ANTIVIRUS=none
ANTISPAM=rspamd
WEBMAIL=roundcube
ADMIN=true
WEBDAV=none
FETCHMAIL=false

# OCI Email Delivery Relay
RELAYHOST=[smtp.email.eu-marseille-1.oci.oraclecloud.com]:587
RELAYUSER=<OCI_SMTP_USER>
RELAYPASSWORD=<OCI_SMTP_PASSWORD>

# Message size limits
MESSAGE_SIZE_LIMIT=50000000

# Initial admin
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=diegonmarcos.com
INITIAL_ADMIN_PW=<SET_INITIAL_PASSWORD>

# Sitename
SITENAME=Diego Mail
WEBSITE=https://mail.diegonmarcos.com

# Database
DB_FLAVOR=sqlite

# Logging
LOG_LEVEL=INFO

# Two-Factor Authentication
CREDENTIAL_ROUNDS=12

# Real IP (leave empty if not behind proxy)
REAL_IP_HEADER=
REAL_IP_FROM=

# Public IP
PUBLICIP=130.110.251.193

# Proxy Authentication (Authelia SSO via NPM)
PROXY_AUTH_WHITELIST=35.226.147.64
PROXY_AUTH_HEADER=X-Forwarded-User
PROXY_AUTH_CREATE=False
