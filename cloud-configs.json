    "authelia": {
      "acl": [
        {
          "domain": "auth.diegonmarcos.com",
          "policy": "bypass"
        },
        {
          "domain": "vault.diegonmarcos.com",
          "policy": "bypass",
          "resources": [
            "^/api.*",
            "^/identity.*",
            "^/icons.*",
            "^/notifications.*",
            "^/attachments.*"
          ]
        },
        {
          "domain": "vault.diegonmarcos.com",
          "policy": "two_factor",
          "resources": [
            "^/admin.*"
          ]
        },
        {
          "domain": "vault.diegonmarcos.com",
          "policy": "bypass"
        },
        {
          "domain": "db.diegonmarcos.com",
          "policy": "bypass",
          "resources": [
            "^/api/.*"
          ]
        },
        {
          "domain": "db.diegonmarcos.com",
          "policy": "two_factor"
        },
        {
          "domain": "*.diegonmarcos.com",
          "policy": "two_factor"
        }
      ]
    },
